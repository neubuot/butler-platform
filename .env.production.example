# Production Environment Variables für Butler Platform
# WICHTIG: Diese Datei NICHT ins Git committen!

# Django Settings
SECRET_KEY=ERSETZE-DIES-MIT-EINEM-SEHR-LANGEN-ZUFÄLLIGEN-STRING
DEBUG=False
ALLOWED_HOSTS=deine-domain.de,www.deine-domain.de,SERVER-IP-ADRESSE

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=butler_platform_prod
DB_USER=butler_user
DB_PASSWORD=SICHERES-DATENBANK-PASSWORT
DB_HOST=localhost
DB_PORT=5432

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=deine-email@gmail.com
EMAIL_HOST_PASSWORD=dein-app-spezifisches-passwort
DEFAULT_FROM_EMAIL=noreply@deine-domain.de

# Security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Application
COMPANY_NAME=rhk-mobil GmbH
PLATFORM_NAME=Butler Asset & Operations Platform

# CORS (Optional - nur wenn API von anderen Domains genutzt wird)
CORS_ALLOWED_ORIGINS=https://deine-domain.de,https://www.deine-domain.de

# Admin URL (Optional - aus Sicherheitsgründen ändern)
# ADMIN_URL=geheimer-admin-pfad/
